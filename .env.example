# Local development only. Generate a unique key before sharing a deployment.
DJANGO_SECRET_KEY=local-development-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_TIME_ZONE=Africa/Casablanca

# Optional Meta Model API connection. Keep real keys in local .env only.
MUSE_APIKEY=
META_MODEL=muse-spark-1.3
META_TIMEOUT_SECONDS=45
