# Local development only. Generate a unique key before sharing a deployment.
DJANGO_SECRET_KEY=local-development-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_TIME_ZONE=Africa/Casablanca

# Optional Meta Model API connection. Keep real keys in local .env only.
MUSE_APIKEY=
META_MODEL=muse-spark-1.3
META_TIMEOUT_SECONDS=45

# Local threshold below the $150 hackathon allowance; outside usage is not tracked.
MUSE_BUDGET_USD=140
MUSE_MAX_OUTPUT_TOKENS=4096
MUSE_GENERATION_OUTPUT_TOKENS=4096
# Standard Muse Spark 1.3 prices per million tokens, checked 2026-10-29.
META_PRICE_MODEL=muse-spark-1.3
META_INPUT_USD_PER_MILLION=1.25
META_CACHED_USD_PER_MILLION=0.15
META_OUTPUT_USD_PER_MILLION=4.25
